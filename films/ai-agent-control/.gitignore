# Secret hygiene
.env*
*.pem
*.key
*credentials*
client_secret*.json
*token*.json
.mcp.json
*.mcp.json
.mcp.local.json

# Film build outputs
node_modules/
.frames/
.tmp/
# drafts and fixtures stay local; the final deliverables in exports/ are committed
exports/draft-*
exports/fixtures*
exports/*-draft*
# the repo root ignores dist/ (Astro build); the film's HTML player is a deliverable
!dist/
